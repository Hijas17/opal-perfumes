#!/bin/sh
# Block Stripe API keys from ever entering a commit.
#
# Key exposure in a repo is the leading cause of Stripe account takeover, and
# git history is effectively permanent — catching it here is far cheaper than
# rotating a live key after the fact.
#
# Bypass with `git commit --no-verify` only if you are certain it's a false
# positive (e.g. this hook itself, or documentation).

if git diff --cached -U0 | grep -nE '^\+.*\b[sr]k_(live|test)_[A-Za-z0-9]{8,}'; then
    echo ""
    echo "✖ Commit blocked: a Stripe API key appears in the staged changes (see above)."
    echo "  Move it to opal-api/.env (gitignored) or a platform secret and re-stage."
    echo "  If it is a LIVE key, roll it now at https://dashboard.stripe.com/apikeys"
    exit 1
fi
