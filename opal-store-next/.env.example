# ─── Opal storefront environment ────────────────────────────────────────────
# Copy to `.env.production` on the Hostinger server (or `.env.local` for dev).
# Vite/Next.js inline NEXT_PUBLIC_* at build time — change a value, rebuild.

# REST API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Static uploads base URL (admin-uploaded product/setting images)
NEXT_PUBLIC_UPLOADS_URL=http://localhost:8000/uploads

# Canonical site URL — used in SEO meta tags, sitemap.xml, JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal/server-only API URL (loopback when API runs on same host).
# Server Components prefer this over NEXT_PUBLIC_API_URL.
# API_URL_INTERNAL=http://127.0.0.1:8000/api

# ─── Feature flags ──────────────────────────────────────────────────────────
# Set to `false` to hide all prices on the storefront (cards, product detail,
# JSON-LD product schema). Default: prices are shown.
# NEXT_PUBLIC_SHOW_PRICES=false

# ─── Ordering paths ─────────────────────────────────────────────────────────
# These two are independent. WhatsApp inquiry no longer replaces checkout:
#
#   WhatsApp only (no accounts, no server-side orders):
#     NEXT_PUBLIC_USE_WHATSAPP_INQUIRY=true
#     NEXT_PUBLIC_ENABLE_CHECKOUT=false
#
#   Both, side by side — cart offers Checkout and Inquire on WhatsApp, and
#   WhatsApp appears as a third option at checkout beside card and COD:
#     NEXT_PUBLIC_USE_WHATSAPP_INQUIRY=true
#     NEXT_PUBLIC_ENABLE_CHECKOUT=true
#     NEXT_PUBLIC_DISABLE_AUTH=false      # REQUIRED — see below
#
#   Checkout only:
#     NEXT_PUBLIC_USE_WHATSAPP_INQUIRY=false
#
# Left unset, ENABLE_CHECKOUT mirrors the old behaviour: on unless WhatsApp
# inquiry is on. It is forced OFF when DISABLE_AUTH=true, because an order is
# written against a logged-in customer — with no accounts there is nobody to
# attach it to, and a Checkout button that 401s is worse than no button.
# NEXT_PUBLIC_ENABLE_CHECKOUT=true

# Set to `true` to replace the Add-to-Cart flow with a WhatsApp inquiry button
# on product detail pages and hide the cart icon. WhatsApp number is read from
# site_settings.whatsapp_number, with a fallback to NEXT_PUBLIC_WHATSAPP_FALLBACK.
# NEXT_PUBLIC_USE_WHATSAPP_INQUIRY=true
# NEXT_PUBLIC_WHATSAPP_FALLBACK=+971501234567

# Set to `true` to hide all login/signup/account UI and redirect those routes
# to the home page. Cart still works — it becomes a client-side guest cart
# backed by localStorage, and checkout is replaced by a WhatsApp inquiry.
# NEXT_PUBLIC_DISABLE_AUTH=true

# ─── Production examples (Hostinger) ────────────────────────────────────────
# NEXT_PUBLIC_API_URL=https://api.opalperfume.com/api
# NEXT_PUBLIC_UPLOADS_URL=https://api.opalperfume.com/uploads
# NEXT_PUBLIC_SITE_URL=https://opalperfume.com
# API_URL_INTERNAL=http://127.0.0.1:8000/api
# NEXT_PUBLIC_SHOW_PRICES=false
# NEXT_PUBLIC_USE_WHATSAPP_INQUIRY=true
# NEXT_PUBLIC_DISABLE_AUTH=true

# ─── Cache purge ────────────────────────────────────────────────────────────
# Shared secret the API presents to POST /api/revalidate after an admin write,
# which drops the cached settings/categories/products reads. Must match
# REVALIDATE_SECRET in the API's .env exactly. NOT a NEXT_PUBLIC_ value — it is
# read on the server only and must never reach the browser bundle.
# Without it the endpoint returns 503 and edits fall back to waiting out the
# ordinary cache TTLs.
REVALIDATE_SECRET=change_this_to_a_random_secret_string

# ─── Stripe (card payments) ─────────────────────────────────────────────────
# PUBLISHABLE key only (pk_test_... / pk_live_...). This one is designed to be
# public and ships in the browser bundle — that is expected and safe.
# The SECRET key belongs in the API's .env and must NEVER appear here: any
# NEXT_PUBLIC_* value is inlined into JavaScript any visitor can read.
# Leave blank to hide the card option and fall back to cash on delivery.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
