MONGO_URI=mongodb://localhost:27017
MONGO_DB=opal_perfumes
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRY=86400
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# ─── Email (inquiry notifications) ───────────────────────────────
# Address inquiries are sent TO (the handler's inbox):
ADMIN_NOTIFICATION_EMAIL=admin@opalperfumes.com
# "From" shown on the notification:
MAIL_FROM=noreply@opalperfumes.com
MAIL_FROM_NAME=Opal Perfumes Website
# Authenticated SMTP (preferred). Leave SMTP_HOST blank to fall back to PHP mail().
# For Hostinger: host=smtp.hostinger.com, secure=ssl, port=465, user=the full mailbox address.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=
SMTP_PASS=

# ─── Storefront cache purge ──────────────────────────────────────
# After any successful admin write, the API pings the storefront to drop its
# cached reads, so edits appear immediately instead of waiting out the
# storefront's 1–10 minute TTLs. Both values must be set for the ping to fire,
# and REVALIDATE_SECRET must match the storefront's copy exactly.
# Leave blank in local development if the storefront is not running.
STOREFRONT_URL=https://opalperfume.com
REVALIDATE_SECRET=change_this_to_a_random_secret_string

# ─── Stripe (card payments) ──────────────────────────────────────
# Use a RESTRICTED key (rk_...) scoped to: Checkout Sessions = write,
# PaymentIntents = read. Not a full secret key (sk_...) — a restricted key
# that leaks can't drain the account. Create one at
# https://dashboard.stripe.com/apikeys
#
# NEVER commit a real key. In production set these as Fly.io secrets
# (`fly secrets set STRIPE_SECRET_KEY=...`), not in a committed file.
# Leave blank to disable card payments — the API then rejects
# payment_method: 'card' with a 503 and cash on delivery keeps working.
STRIPE_SECRET_KEY=
# From https://dashboard.stripe.com/webhooks after adding the endpoint
# <API_URL>/api/stripe/webhook, or printed by `stripe listen` in local dev.
# Without this the webhook rejects every request — orders would never be
# marked paid.
STRIPE_WEBHOOK_SECRET=
