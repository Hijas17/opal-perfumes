# ─── Server / local configuration for docker-compose ────────────────────────
# Copy to `.env` (gitignored) and fill in. docker-compose reads this file
# automatically and substitutes the values into docker-compose.yml.
#
# Everything here used to be edited directly into docker-compose.yml on the
# server. That collided with every `git pull` and put secrets in a tracked
# file. Keep them here instead — this file is never committed.

# ─── Network binding ────────────────────────────────────────────────────────
# Defaults to 127.0.0.1 (loopback only), which is what you want on a public
# VPS — nginx proxies to it. Set to 0.0.0.0 ONLY for LAN access in dev.
# BIND_ADDR=127.0.0.1

# ─── Database ───────────────────────────────────────────────────────────────
# MONGO_URI=mongodb://mongodb:27017
# MONGO_DB=opal_perfumes

# ─── Auth ───────────────────────────────────────────────────────────────────
# MUST be set in production. The fallback in docker-compose.yml is public in
# this repo, so tokens signed with it can be forged by anyone. Generate one:
#   openssl rand -hex 32
JWT_SECRET=

# ─── CORS ───────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://opalperfume.com,https://www.opalperfume.com,https://admin.opalperfume.com

# ─── Mail ───────────────────────────────────────────────────────────────────
# MAIL_FROM=info@opalperfume.com
# MAIL_FROM_NAME=Customer Enquiry
# ADMIN_NOTIFICATION_EMAIL=info@opalperfume.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=ssl
# SMTP_USER=info@opalperfume.com
SMTP_PASS=

# ─── Storefront cache purge ─────────────────────────────────────────────────
# Must match REVALIDATE_SECRET in the storefront's env exactly.
REVALIDATE_SECRET=

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Storefront origin Stripe returns the customer to after Checkout.
STOREFRONT_URL=http://localhost:3000
# Restricted key (rk_...) scoped to Checkout Sessions = write.
# Use a TEST key here. Never a live key in a working tree.
STRIPE_SECRET_KEY=
# From `stripe listen`, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=
