# ─── Local development secrets for docker-compose ───────────────────────────
# Copy to `.env` (gitignored) and fill in. docker-compose reads this file
# automatically and passes the values into the API container.
#
# Use TEST keys here (sk_test_… / rk_test_…). Never a live key: this sits in
# your working tree, one `git add -A` away from your history.

# Restricted key scoped to Checkout Sessions=write, PaymentIntents=read.
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:8000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Storefront origin Stripe returns the customer to.
STOREFRONT_URL=http://localhost:3000
